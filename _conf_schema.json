{
  "enabled": {
    "description": "启用红包提醒",
    "type": "bool",
    "default": true
  },
  "debug": {
    "description": "调试模式",
    "type": "bool",
    "default": false
  },
  "bot_qq": {
    "description": "机器人QQ",
    "type": "string",
    "default": ""
  },
  "allow_password_redpacket": {
    "description": "提醒口令红包",
    "type": "bool",
    "default": false
  },
  "owner_id": {
    "description": "接收提醒的QQ",
    "type": "string",
    "default": ""
  },
  "owner_ids": {
    "description": "接收提醒的QQ列表，逗号分隔",
    "type": "string",
    "default": ""
  },
  "watch_groups": {
    "description": "监听群号，逗号分隔",
    "type": "string",
    "default": ""
  },
  "notify_template": {
    "description": "提醒模板",
    "type": "text",
    "default": "💰 红包提醒\n群：{group_name}（{group_id}）\n发送者：{sender_name}（{sender_id}）\n时间：{time}\n快去抢！"
  }
}