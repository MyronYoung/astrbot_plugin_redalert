{
  "enabled": {
    "description": "启用红包提醒",
    "type": "bool",
    "default": true
  },
  "debug": {
    "description": "调试模式",
    "type": "bool",
    "default": false
  },
  "bot_qq": {
    "description": "机器人QQ",
    "type": "string",
    "default": ""
  },
  "allow_password_redpacket": {
    "description": "提醒口令红包",
    "type": "bool",
    "default": false
  },
  "owner_id": {
    "description": "接收提醒的QQ",
    "type": "string",
    "default": ""
  },
  "owner_ids": {
    "description": "接收提醒的QQ列表，逗号分隔",
    "type": "string",
    "default": ""
  },
  "watch_groups": {
    "description": "监听群号，逗号分隔",
    "type": "string",
    "default": ""
  },
  "notify_template": {
    "description": "提醒模板",
    "type": "text",
    "default": "💰 红包提醒\n群：{group_name}（{group_id}）\n发送者：{sender_name}（{sender_id}）\n时间：{time}\n快去抢！"
  },
  "group_thanks_enabled": {
    "description": "检测到可领取红包后，在群里发感谢",
    "type": "bool",
    "default": true
  },
  "group_thanks_template": {
    "description": "群感谢模板",
    "type": "text",
    "default": "谢谢 {sender_name} 的红包！鱼鱼收下这份投喂啦～"
  }
}